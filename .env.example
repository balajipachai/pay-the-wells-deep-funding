# Copy to .env (gitignored). Never put a private key here: import it with `cast wallet import`.
SEPOLIA_RPC_URL=
DEPLOYER=                 # address of the keystore account that deploys (it gets no powers)
KEYSTORE_ACCOUNT=deployer
ETHERSCAN_API_KEY=        # optional; without it the source is verified on Sourcify

JURORS=                   # comma-separated 0x addresses, at least 3, fixed forever at deployment
BOND_SINK=                # receives forfeited dispute bonds
JUDGING_SECONDS=86400     # how long jurors have to judge
DISPUTE_WINDOW_SECONDS=86400
DISPUTE_BOND_WEI=100000000000000000   # 0.1 ETH
POT_WEI=                  # thank-you pot funded at deploy, e.g. 1000000000000000000 for 1 ETH
